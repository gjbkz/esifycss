{
    "name": "esifycss-workspace",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "npm run build --workspaces",
        "lint": "biome lint packages/esifycss/src packages/esifycss/test-client packages/esifycss/@types packages/rollup-plugin-embed-css/src packages/esifycss-webpack-plugin/src",
        "test": "npm run test --workspaces",
        "test-client": "npm run test-client --workspace esifycss"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.2",
        "@types/node": "22.20.5",
        "@types/selenium-webdriver": "4.35.7",
        "browserstack-local": "1.5.9",
        "postcss-scss": "4.0.9",
        "rollup": "4.64.7",
        "selenium-webdriver": "4.51.0",
        "ts-node": "10.9.2",
        "typescript": "5.9.3",
        "webpack": "5.112.0"
    },
    "renovate": {
        "extends": [
            "github>nlibjs/renovate-config"
        ]
    }
}
