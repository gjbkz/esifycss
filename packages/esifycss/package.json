{
    "name": "esifycss",
    "version": "2.0.0",
    "description": "Generates .js or .ts exports class names and custom properties",
    "author": {
        "name": "Kei Ito",
        "email": "kei.itof@gmail.com",
        "url": "https://github.com/gjbkz"
    },
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjbkz/esifycss.git",
        "directory": "packages/esifycss"
    },
    "main": "lib/index.js",
    "files": [
        "lib",
        "@types"
    ],
    "bin": {
        "esifycss": "lib/bin/esifycss.js"
    },
    "scripts": {
        "build": "node scripts/build.js",
        "test": "npm run test:unit",
        "test-client": "npm run test:compile && node --test --test-timeout=120000 temp/test/test-client/run.js",
        "prepack": "npm run build",
        "test:unit": "npm run test:compile && node --test --test-timeout=120000 \"temp/test/src/**/*.test.js\"",
        "test:compile": "node -e \"require('node:fs').rmSync('temp/test', {recursive:true,force:true})\" && tsc --project tsconfig.test.json && tsc --project tsconfig.helper.json --outDir temp/test/src/helper"
    },
    "dependencies": {
        "@hookun/parse-animation-shorthand": "0.1.5",
        "acorn": "8.19.0",
        "acorn-walk": "8.3.5",
        "chokidar": "4.0.3",
        "commander": "15.0.0",
        "picomatch": "4.0.7",
        "postcss": "8.5.31",
        "postcss-selector-parser": "7.1.7",
        "vlq": "2.0.4"
    },
    "types": "lib/index.d.ts"
}
