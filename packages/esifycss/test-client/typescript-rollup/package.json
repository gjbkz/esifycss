{
    "private": true,
    "scripts": {
        "build:esifycss": "esifycss --helper src/helper.css.ts src/**/*.css",
        "build:tsc": "tsc",
        "build:rollup": "rollup temp/page.js --format iife --file output/page.js",
        "build:html": "node -e \"require('node:fs').copyFileSync('src/index.html', 'output/index.html')\"",
        "build": "npm run build:esifycss && npm run build:tsc && npm run build:rollup && npm run build:html"
    },
    "devDependencies": {
        "esifycss": "file:../..",
        "rollup": "4.64.7",
        "typescript": "5.9.3"
    }
}
